<Window x:Class="PaperlessDesktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SettingsHeading}" Width="535" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="14" Foreground="{DynamicResource TextBrush}"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="0,0,0,5" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="{DynamicResource SettingsHeading}" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,16" />

        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                Background="{DynamicResource SurfaceBrush}" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="{DynamicResource ThemeLabel}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{DynamicResource LightTheme}" IsChecked="{Binding IsLight, Mode=TwoWay}"
                                     GroupName="Theme" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <RadioButton Content="{DynamicResource DarkTheme}" IsChecked="{Binding IsDark, Mode=TwoWay}"
                                     GroupName="Theme" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource LanguageLabel}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SerbianOption" Content="{DynamicResource SerbianLanguage}"
                                     IsChecked="{Binding IsSerbian, Mode=TwoWay}" GroupName="Language" Margin="0,0,12,0" />
                        <RadioButton x:Name="EnglishOption" Content="{DynamicResource EnglishLanguage}"
                                     IsChecked="{Binding IsEnglish, Mode=TwoWay}" GroupName="Language" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                Background="{DynamicResource SurfaceBrush}" Padding="14">
            <StackPanel>
                <TextBlock Text="{DynamicResource AccentColorLabel}" FontWeight="SemiBold" Margin="0,0,0,10" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="34" />
                        <RowDefinition Height="34" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <Label Content="{DynamicResource AccentRedLabel}" Target="{Binding ElementName=RedChannel}" VerticalAlignment="Center" />
                    <Slider x:Name="RedChannel" Grid.Column="1" Maximum="255" SmallChange="1" LargeChange="16"
                            IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Red, Mode=TwoWay}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Red}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <Label Grid.Row="1" Content="{DynamicResource AccentGreenLabel}" Target="{Binding ElementName=GreenChannel}" VerticalAlignment="Center" />
                    <Slider x:Name="GreenChannel" Grid.Row="1" Grid.Column="1" Maximum="255" SmallChange="1" LargeChange="16"
                            IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Green, Mode=TwoWay}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Green}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <Label Grid.Row="2" Content="{DynamicResource AccentBlueLabel}" Target="{Binding ElementName=BlueChannel}" VerticalAlignment="Center" />
                    <Slider x:Name="BlueChannel" Grid.Row="2" Grid.Column="1" Maximum="255" SmallChange="1" LargeChange="16"
                            IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Blue, Mode=TwoWay}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Blue}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,18,0">
                        <Label Content="{DynamicResource AccentHexLabel}" Target="{Binding ElementName=AccentInput}" />
                        <TextBox x:Name="AccentInput" Text="{Binding AccentHex, UpdateSourceTrigger=PropertyChanged}"
                                 CharacterCasing="Upper" MaxLength="7" FontFamily="Consolas" MinWidth="114"
                                 MinHeight="33" Padding="7,4" VerticalContentAlignment="Center" />
                    </StackPanel>
                    <Border Grid.Column="1" MinHeight="34" VerticalAlignment="Bottom" CornerRadius="4"
                            Background="{Binding AccentPreview}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            AutomationProperties.Name="{DynamicResource AccentPreviewName}" />
                </Grid>
                <TextBlock Margin="0,7,0,0" Text="{DynamicResource InvalidAccentColor}" TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}" AutomationProperties.LiveSetting="Polite"
                           Visibility="{Binding HasAccentError, Converter={StaticResource BooleanToVisibility}}" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="SaveError" Text="{DynamicResource SettingsSaveFailed}" Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource CancelButton}" IsCancel="True" MinHeight="34" MinWidth="82" Padding="8,4" />
            <Button Content="{DynamicResource SaveButton}" IsDefault="True" IsEnabled="{Binding HasValidAccent}"
                    Click="Save_Click" Style="{DynamicResource ActionButtonStyle}" MinWidth="82" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
