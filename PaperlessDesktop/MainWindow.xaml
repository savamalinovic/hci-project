<Window x:Class="PaperlessDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paperless Desktop"
        Width="940" Height="610" MinWidth="640" MinHeight="410"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14"
        Background="#F4F6F5" Foreground="#182722">
    <Grid Margin="32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Paperless Desktop" FontSize="28" FontWeight="SemiBold" />

        <Border Grid.Row="1" Margin="0,18,0,22" Padding="16" Background="White"
                BorderBrush="#D9E3DE" BorderThickness="1" CornerRadius="8">
            <Grid x:Name="ConnectionForm">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <Label Content="_Adresa servera" Target="{Binding ElementName=ServerAddress}" Padding="0,0,0,5" />
                    <TextBox x:Name="ServerAddress" MinHeight="34" Padding="8,4"
                             VerticalContentAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <Label Content="API _token" Target="{Binding ElementName=ApiToken}" Padding="0,0,0,5" />
                    <PasswordBox x:Name="ApiToken" MinHeight="34" Padding="8,4"
                                 VerticalContentAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="2" Content="_Učitaj dokumente" IsDefault="True"
                        Click="LoadDocuments_Click" VerticalAlignment="Bottom" MinHeight="34"
                        Padding="12,4" Background="#17664F" Foreground="White" BorderThickness="0" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Dokumenti" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8" />
            <DataGrid x:Name="Documents" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserSortColumns="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" BorderBrush="#D9E3DE" Background="White"
                      RowBackground="White" AlternatingRowBackground="#F7FAF8" RowHeight="36"
                      AutomationProperties.Name="Dokumenti">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Naziv" Binding="{Binding Title}" Width="*" />
                    <DataGridTextColumn Header="Datum dokumenta" Width="160"
                                        Binding="{Binding Created, StringFormat={}{0:dd.MM.yyyy}}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <ProgressBar x:Name="LoadProgress" IsIndeterminate="True" Height="3" Visibility="Collapsed"
                         AutomationProperties.Name="Učitavanje dokumenata" />
            <TextBlock x:Name="ConnectionStatus" Margin="0,4,0,0" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"
                       Text="Unesite adresu Paperless servera i API token za prikaz dokumenata." />
        </StackPanel>
    </Grid>
</Window>
