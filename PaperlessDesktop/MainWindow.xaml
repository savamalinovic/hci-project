<Window x:Class="PaperlessDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppTitle}"
        Width="1180" Height="760" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style x:Key="ListCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
    </Window.Resources>
    <Grid Margin="32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" Content="{DynamicResource SettingsButton}" Click="Settings_Click"
                    MinHeight="34" Padding="12,4" VerticalAlignment="Center" />
            <TextBlock Text="{DynamicResource AppTitle}" FontSize="28" FontWeight="SemiBold" />
        </DockPanel>

        <Border Grid.Row="1" Margin="0,18,0,22" Padding="16" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid IsEnabled="{Binding CanConnect}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <Label Content="{DynamicResource ServerAddressLabel}" Target="{Binding ElementName=ServerAddress}" Padding="0,0,0,5" />
                    <TextBox x:Name="ServerAddress" MinHeight="34" Padding="8,4"
                             VerticalContentAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <Label Content="{DynamicResource ApiTokenLabel}" Target="{Binding ElementName=ApiToken}" Padding="0,0,0,5" />
                    <PasswordBox x:Name="ApiToken" MinHeight="34" Padding="8,4"
                                 VerticalContentAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="2" Content="{DynamicResource LoadDocumentsButton}" IsDefault="{Binding IsConnectionRequired}"
                        Click="LoadDocuments_Click" VerticalAlignment="Bottom"
                        Style="{StaticResource ActionButtonStyle}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,16" IsEnabled="{Binding CanSearch}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,10,0">
                <Label Content="{DynamicResource KeywordLabel}" Target="{Binding ElementName=KeywordSearch}" Padding="0,0,0,5" />
                <TextBox x:Name="KeywordSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="34" Padding="8,4" VerticalContentAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ApplyFiltersCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <Label Content="{DynamicResource TagFilterLabel}" Target="{Binding ElementName=TagFilter}" Padding="0,0,0,5" />
                <ComboBox x:Name="TagFilter" MinHeight="34" ItemsSource="{Binding Tags}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedTag, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                <Label Content="{DynamicResource CorrespondentFilterLabel}" Target="{Binding ElementName=CorrespondentFilter}" Padding="0,0,0,5" />
                <ComboBox x:Name="CorrespondentFilter" MinHeight="34" ItemsSource="{Binding Correspondents}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedCorrespondent, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="0,0,10,0">
                <Label Content="{DynamicResource TypeFilterLabel}" Target="{Binding ElementName=TypeFilter}" Padding="0,0,0,5" />
                <ComboBox x:Name="TypeFilter" MinHeight="34" ItemsSource="{Binding DocumentTypes}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedDocumentType, Mode=TwoWay}" />
            </StackPanel>
            <Button Grid.Column="4" Content="{DynamicResource SearchButton}" Command="{Binding ApplyFiltersCommand}"
                    Style="{StaticResource ActionButtonStyle}" VerticalAlignment="Bottom" />
            <Button Grid.Column="5" Content="{DynamicResource ClearSearchButton}" Command="{Binding ClearFiltersCommand}"
                    MinHeight="34" Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Bottom" />
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding CanSearch}">
                        <Button Content="{DynamicResource UploadButton}" Click="UploadDocument_Click" MinHeight="30" Padding="10,3" />
                        <Button Content="{DynamicResource ManageTagsButton}" Click="ManageTags_Click" MinHeight="30" Padding="10,3"
                                Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource DocumentsHeading}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <TabControl x:Name="DocumentViews" Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}"
                            AutomationProperties.Name="{DynamicResource DocumentViewsName}">
                    <TabItem Header="{DynamicResource TableTab}" Padding="14,4">
                        <DataGrid ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  CanUserAddRows="False" CanUserSortColumns="False" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="36"
                                  AutomationProperties.Name="{DynamicResource DocumentTableName}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Document.Title}"
                                                    Width="2*" MinWidth="140" ElementStyle="{StaticResource ListCell}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{DynamicResource NameColumn}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="110" ElementStyle="{StaticResource ListCell}"
                                                    Binding="{Binding CreatedDisplay}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{DynamicResource DateColumn}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding TypeName}"
                                                    Width="*" MinWidth="82" ElementStyle="{StaticResource ListCell}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{DynamicResource TypeColumn}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding TagNames}"
                                                    Width="1.4*" MinWidth="100" ElementStyle="{StaticResource ListCell}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{DynamicResource TagsColumn}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="{DynamicResource CardsTab}" Padding="14,4">
                        <ListBox ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                                 BorderThickness="0" Padding="6" Background="{DynamicResource SurfaceBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                                 AutomationProperties.Name="{DynamicResource DocumentCardsName}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Width" Value="246" />
                                    <Setter Property="Margin" Value="5" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Card" Background="{DynamicResource SurfaceAltBrush}" Padding="12"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Document.Title}" FontSize="16" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Document.Title}" />
                                        <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource MutedTextBrush}"
                                                   Text="{Binding CreatedDisplay}" />
                                        <TextBlock Text="{Binding TypeName}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding TypeName}" />
                                        <TextBlock Text="{Binding TagNames}" Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding TagNames}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                </TabControl>
            </Grid>

            <Border Grid.Column="1" Width="360" Margin="16,0,0,0" Padding="12" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" DataContext="{Binding Preview}"
                    Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{DynamicResource ClosePreviewButton}" Click="ClosePreview_Click"
                                MinHeight="28" Padding="8,2" Margin="8,0,0,0"
                                AutomationProperties.Name="{DynamicResource ClosePreviewName}" />
                        <TextBlock Text="{DynamicResource PreviewHeading}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel Grid.Row="1" Margin="0,10,0,9">
                        <TextBlock Text="{Binding Item.Document.Title}" FontSize="16" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Item.Document.Title}" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding Item.CreatedDisplay}" />
                        <TextBlock Text="{Binding TypeLabel}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Item.TypeName}" />
                        <TextBlock Text="{Binding CorrespondentLabel}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Item.CorrespondentName}" />
                        <TextBlock Text="{Binding TagsLabel}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Item.TagNames}" />
                    </StackPanel>
                    <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="3" Padding="8">
                        <ScrollViewer x:Name="PreviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Image Source="{Binding Image, NotifyOnTargetUpdated=True}" TargetUpdated="PreviewImage_TargetUpdated"
                                   Stretch="Uniform" VerticalAlignment="Top"
                                   AutomationProperties.Name="{DynamicResource PreviewPageName}" />
                        </ScrollViewer>
                    </Border>
                    <StackPanel Grid.Row="3" Margin="0,6,0,0">
                        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                                   Visibility="{Binding HasNotice, Converter={StaticResource BooleanToVisibility}}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Visibility="{Binding HasMultiplePages, Converter={StaticResource BooleanToVisibility}}">
                            <Button Content="‹" Command="{Binding PreviousPageCommand}" MinWidth="34" MinHeight="28"
                                    AutomationProperties.Name="{DynamicResource PreviewPreviousName}" />
                            <TextBlock Text="{Binding PageLabel}" Margin="10,0" VerticalAlignment="Center" />
                            <Button Content="›" Command="{Binding NextPageCommand}" MinWidth="34" MinHeight="28"
                                    AutomationProperties.Name="{DynamicResource PreviewNextName}" />
                        </StackPanel>
                    </StackPanel>
                    <Expander Grid.Row="4" Margin="0,8,0,0" Header="{DynamicResource DocumentText}"
                              Visibility="{Binding HasExtractedText, Converter={StaticResource BooleanToVisibility}}">
                        <TextBox Text="{Binding ExtractedText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 MaxHeight="86" Padding="4" VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="{DynamicResource DocumentText}" />
                    </Expander>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.ColumnSpan="2" IsIndeterminate="True" Height="3" Margin="0,0,0,4"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}"
                         AutomationProperties.Name="{DynamicResource LoadingDocumentsName}" />
            <TextBlock Grid.Row="1" Margin="0,0,12,0" TextWrapping="Wrap" VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite"
                       Text="{Binding StatusMessage}" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                <Button Content="{DynamicResource PreviousButton}" MinHeight="32" Padding="12,3" Command="{Binding PreviousPageCommand}" />
                <TextBlock Text="{Binding PageLabel}" Margin="12,0" VerticalAlignment="Center" />
                <Button Content="{DynamicResource NextButton}" MinHeight="32" Padding="12,3" Command="{Binding NextPageCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
