<Window x:Class="PaperlessDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paperless Desktop"
        Width="1180" Height="760" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14"
        Background="#F4F6F5" Foreground="#182722">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style x:Key="ListCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Background" Value="#17664F" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4"
                                BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#135741" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#F0D283" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Background" Value="#DCE5E0" />
                                <Setter Property="Foreground" Value="#4D6258" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Paperless Desktop" FontSize="28" FontWeight="SemiBold" />

        <Border Grid.Row="1" Margin="0,18,0,22" Padding="16" Background="White"
                BorderBrush="#D9E3DE" BorderThickness="1" CornerRadius="8">
            <Grid IsEnabled="{Binding CanConnect}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <Label Content="_Adresa servera" Target="{Binding ElementName=ServerAddress}" Padding="0,0,0,5" />
                    <TextBox x:Name="ServerAddress" MinHeight="34" Padding="8,4"
                             VerticalContentAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <Label Content="API _token" Target="{Binding ElementName=ApiToken}" Padding="0,0,0,5" />
                    <PasswordBox x:Name="ApiToken" MinHeight="34" Padding="8,4"
                                 VerticalContentAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="2" Content="_Učitaj dokumente" IsDefault="{Binding IsConnectionRequired}"
                        Click="LoadDocuments_Click" VerticalAlignment="Bottom"
                        Style="{StaticResource ActionButton}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,16" IsEnabled="{Binding CanSearch}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,10,0">
                <Label Content="_Ključne riječi" Target="{Binding ElementName=KeywordSearch}" Padding="0,0,0,5" />
                <TextBox x:Name="KeywordSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="34" Padding="8,4" VerticalContentAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ApplyFiltersCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <Label Content="_Tag" Target="{Binding ElementName=TagFilter}" Padding="0,0,0,5" />
                <ComboBox x:Name="TagFilter" MinHeight="34" ItemsSource="{Binding Tags}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedTag, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                <Label Content="K_orespondent" Target="{Binding ElementName=CorrespondentFilter}" Padding="0,0,0,5" />
                <ComboBox x:Name="CorrespondentFilter" MinHeight="34" ItemsSource="{Binding Correspondents}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedCorrespondent, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="0,0,10,0">
                <Label Content="T_ip dokumenta" Target="{Binding ElementName=TypeFilter}" Padding="0,0,0,5" />
                <ComboBox x:Name="TypeFilter" MinHeight="34" ItemsSource="{Binding DocumentTypes}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedDocumentType, Mode=TwoWay}" />
            </StackPanel>
            <Button Grid.Column="4" Content="_Pretraži" Command="{Binding ApplyFiltersCommand}"
                    Style="{StaticResource ActionButton}" VerticalAlignment="Bottom" />
            <Button Grid.Column="5" Content="O_čisti" Command="{Binding ClearFiltersCommand}"
                    MinHeight="34" Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Bottom" />
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding CanSearch}">
                        <Button Content="_Dodaj dokument" Click="UploadDocument_Click" MinHeight="30" Padding="10,3" />
                        <Button Content="_Upravljaj tagovima" Click="ManageTags_Click" MinHeight="30" Padding="10,3"
                                Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="Dokumenti" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <TabControl x:Name="DocumentViews" Grid.Row="1" BorderBrush="#D9E3DE" Background="White"
                            AutomationProperties.Name="Prikaz dokumenata">
                    <TabItem Header="Tabela" Padding="14,4">
                        <DataGrid ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  CanUserAddRows="False" CanUserSortColumns="False" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#D9E3DE"
                                  BorderThickness="0" Background="White" RowBackground="White"
                                  AlternatingRowBackground="#F7FAF8" RowHeight="36"
                                  AutomationProperties.Name="Tabela dokumenata">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Naziv" Binding="{Binding Document.Title}"
                                                    Width="2*" MinWidth="140" ElementStyle="{StaticResource ListCell}" />
                                <DataGridTextColumn Header="Datum" Width="110" ElementStyle="{StaticResource ListCell}"
                                                    Binding="{Binding Document.Created, StringFormat={}{0:dd.MM.yyyy}, TargetNullValue=—}" />
                                <DataGridTextColumn Header="Tip" Binding="{Binding TypeName}"
                                                    Width="*" MinWidth="82" ElementStyle="{StaticResource ListCell}" />
                                <DataGridTextColumn Header="Tagovi" Binding="{Binding TagNames}"
                                                    Width="1.4*" MinWidth="100" ElementStyle="{StaticResource ListCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Kartice" Padding="14,4">
                        <ListBox ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                                 BorderThickness="0" Padding="6" Background="White"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                                 AutomationProperties.Name="Kartice dokumenata">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Width" Value="246" />
                                    <Setter Property="Margin" Value="5" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Card" Background="#F7FAF8" Padding="12"
                                                        BorderBrush="#D9E3DE" BorderThickness="1" CornerRadius="6">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="#79A695" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Card" Property="Background" Value="#E3F1EB" />
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="#17664F" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Document.Title}" FontSize="16" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Document.Title}" />
                                        <TextBlock Margin="0,7,0,0" Foreground="#39574B"
                                                   Text="{Binding Document.Created, StringFormat={}{0:dd.MM.yyyy}, TargetNullValue=Bez datuma}" />
                                        <TextBlock Text="{Binding TypeName}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding TypeName}" />
                                        <TextBlock Text="{Binding TagNames}" Margin="0,8,0,0" Foreground="#39574B"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding TagNames}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                </TabControl>
            </Grid>

            <Border Grid.Column="1" Width="360" Margin="16,0,0,0" Padding="12" Background="White"
                    BorderBrush="#D9E3DE" BorderThickness="1" CornerRadius="6" DataContext="{Binding Preview}"
                    Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Zatvori" Click="ClosePreview_Click"
                                MinHeight="28" Padding="8,2" Margin="8,0,0,0"
                                AutomationProperties.Name="Zatvori pregled" />
                        <TextBlock Text="Pregled dokumenta" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel Grid.Row="1" Margin="0,10,0,9">
                        <TextBlock Text="{Binding Item.Document.Title}" FontSize="16" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Item.Document.Title}" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding Item.Document.Created, StringFormat={}{0:dd.MM.yyyy}, TargetNullValue=Bez datuma}" />
                        <TextBlock Text="{Binding Item.TypeName, StringFormat='Tip: {0}'}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Item.TypeName}" />
                        <TextBlock Text="{Binding Item.CorrespondentName, StringFormat='Korespondent: {0}'}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Item.CorrespondentName}" />
                        <TextBlock Text="{Binding Item.TagNames, StringFormat='Tagovi: {0}'}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Item.TagNames}" />
                    </StackPanel>
                    <Border Grid.Row="2" Background="#E9EFEC" CornerRadius="3" Padding="8">
                        <ScrollViewer x:Name="PreviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Image Source="{Binding Image, NotifyOnTargetUpdated=True}" TargetUpdated="PreviewImage_TargetUpdated"
                                   Stretch="Uniform" VerticalAlignment="Top"
                                   AutomationProperties.Name="Stranica dokumenta" />
                        </ScrollViewer>
                    </Border>
                    <StackPanel Grid.Row="3" Margin="0,6,0,0">
                        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                                   Visibility="{Binding HasNotice, Converter={StaticResource BooleanToVisibility}}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Visibility="{Binding HasMultiplePages, Converter={StaticResource BooleanToVisibility}}">
                            <Button Content="‹" Command="{Binding PreviousPageCommand}" MinWidth="34" MinHeight="28"
                                    AutomationProperties.Name="Prethodna stranica pregleda" />
                            <TextBlock Text="{Binding PageLabel}" Margin="10,0" VerticalAlignment="Center" />
                            <Button Content="›" Command="{Binding NextPageCommand}" MinWidth="34" MinHeight="28"
                                    AutomationProperties.Name="Sljedeća stranica pregleda" />
                        </StackPanel>
                    </StackPanel>
                    <Expander Grid.Row="4" Margin="0,8,0,0" Header="Tekst dokumenta"
                              Visibility="{Binding HasExtractedText, Converter={StaticResource BooleanToVisibility}}">
                        <TextBox Text="{Binding ExtractedText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 MaxHeight="86" Padding="4" VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Tekst dokumenta" />
                    </Expander>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.ColumnSpan="2" IsIndeterminate="True" Height="3" Margin="0,0,0,4"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}"
                         AutomationProperties.Name="Učitavanje dokumenata" />
            <TextBlock Grid.Row="1" Margin="0,0,12,0" TextWrapping="Wrap" VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite"
                       Text="{Binding StatusMessage}" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                <Button Content="_Prethodna" MinHeight="32" Padding="12,3" Command="{Binding PreviousPageCommand}" />
                <TextBlock Text="{Binding PageLabel}" Margin="12,0" VerticalAlignment="Center" />
                <Button Content="_Sljedeća" MinHeight="32" Padding="12,3" Command="{Binding NextPageCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
