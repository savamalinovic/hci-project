<Window x:Class="PaperlessDesktop.NaturalSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource NaturalSearchHeading}" Width="660" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="14" Foreground="{DynamicResource TextBrush}"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock FontSize="25" FontWeight="SemiBold" Text="{DynamicResource NaturalSearchHeading}" />
        <TextBlock Text="{DynamicResource NaturalInterpreterLabel}" Margin="0,14,0,6" />
        <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanEditQuery}">
            <RadioButton Content="{DynamicResource NaturalGeminiOption}" IsChecked="{Binding UseGemini, Mode=TwoWay}"
                         GroupName="Interpreter" Margin="0,0,16,0" />
            <RadioButton Content="{DynamicResource NaturalLocalOption}" IsChecked="{Binding UseLocalParser, Mode=TwoWay}"
                         GroupName="Interpreter" />
        </StackPanel>
        <CheckBox Content="{DynamicResource NaturalIncludeTitles}" IsChecked="{Binding IncludeDocumentTitles, Mode=TwoWay}"
                  IsEnabled="{Binding CanEditQuery}" Margin="0,8,0,0"
                  Visibility="{Binding UseGemini, Converter={StaticResource BooleanToVisibility}}" />
        <Label Content="{DynamicResource NaturalQueryLabel}" Target="{Binding ElementName=NaturalQuery}" Margin="0,12,0,0" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="{DynamicResource NaturalInterpretButton}" Command="{Binding InterpretCommand}"
                    Margin="8,0,0,0" Style="{StaticResource ActionButtonStyle}" />
            <TextBox x:Name="NaturalQuery" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" MaxLength="300"
                     MinHeight="34" Padding="8,4" VerticalContentAlignment="Center" IsEnabled="{Binding CanEditQuery}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding InterpretCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>
        <TextBlock Text="{DynamicResource NaturalExample}" Foreground="{DynamicResource MutedTextBrush}"
                   TextWrapping="Wrap" Margin="0,6,0,0" />
        <ProgressBar Height="3" Margin="0,10,0,0" IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}"
                     AutomationProperties.Name="{DynamicResource NaturalInterpreting}" />

        <Border Margin="0,15,0,0" Padding="13" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5"
                Visibility="{Binding HasInterpretation, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel>
                <TextBlock Text="{DynamicResource NaturalFiltersHeading}" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Label Content="{DynamicResource KeywordLabel}" Target="{Binding ElementName=InterpretedText}" />
                <TextBox x:Name="InterpretedText" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" MaxLength="300"
                         MinHeight="32" Padding="8,4" VerticalContentAlignment="Center" />
                <Grid Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <Label Content="{DynamicResource TagFilterLabel}" Target="{Binding ElementName=InterpretedTag}" />
                        <ComboBox x:Name="InterpretedTag" ItemsSource="{Binding Tags}" SelectedItem="{Binding Tag, Mode=TwoWay}"
                                  DisplayMemberPath="Name" MinHeight="32" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <Label Content="{DynamicResource CorrespondentFilterLabel}" Target="{Binding ElementName=InterpretedCorrespondent}" />
                        <ComboBox x:Name="InterpretedCorrespondent" ItemsSource="{Binding Correspondents}"
                                  SelectedItem="{Binding Correspondent, Mode=TwoWay}" DisplayMemberPath="Name" MinHeight="32" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="{DynamicResource TypeFilterLabel}" Target="{Binding ElementName=InterpretedType}" />
                        <ComboBox x:Name="InterpretedType" ItemsSource="{Binding DocumentTypes}"
                                  SelectedItem="{Binding DocumentType, Mode=TwoWay}" DisplayMemberPath="Name" MinHeight="32" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <Label Content="{DynamicResource NaturalFromLabel}" Target="{Binding ElementName=InterpretedFrom}" />
                        <TextBox x:Name="InterpretedFrom" Text="{Binding From, UpdateSourceTrigger=PropertyChanged}" MaxLength="10"
                                 MinHeight="32" Padding="8,4" VerticalContentAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Label Content="{DynamicResource NaturalToLabel}" Target="{Binding ElementName=InterpretedTo}" />
                        <TextBox x:Name="InterpretedTo" Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" MaxLength="10"
                                 MinHeight="32" Padding="8,4" VerticalContentAlignment="Center" />
                    </StackPanel>
                </Grid>
                <StackPanel Margin="0,9,0,0" Visibility="{Binding HasProposedDocuments, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Text="{DynamicResource NaturalSuggestedDocuments}" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <ScrollViewer MaxHeight="105" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ProposedDocuments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,2">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                   AutomationProperties.LiveSetting="Polite" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{DynamicResource CancelButton}" IsCancel="True" MinHeight="34" MinWidth="85" />
            <Button Content="{DynamicResource SearchButton}" Click="Apply_Click" IsDefault="{Binding HasInterpretation}"
                    IsEnabled="{Binding HasInterpretation}" Style="{StaticResource ActionButtonStyle}"
                    MinWidth="96" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
