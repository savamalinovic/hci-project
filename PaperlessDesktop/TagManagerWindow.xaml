<Window x:Class="PaperlessDesktop.TagManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource TagManagerHeading}"
        Width="730" Height="470" MinWidth="620" MinHeight="390"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource StandardButtonStyle}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,4" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Margin="0,0,16,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Content="{DynamicResource RefreshButton}" Command="{Binding RefreshCommand}" Style="{StaticResource DialogButton}" />
                        <Button Content="{DynamicResource NewTagButton}" IsEnabled="{Binding CanEdit}" Click="NewTag_Click"
                                Style="{StaticResource DialogButton}" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource TagsColumn}" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <DataGrid ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag, Mode=TwoWay}"
                          IsEnabled="{Binding CanEdit}" IsReadOnly="True" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" SelectionMode="Single"
                          HeadersVisibility="Column" RowHeight="34" GridLinesVisibility="Horizontal"
                          AutomationProperties.Name="{DynamicResource TagListName}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Name}" Width="*">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource NameColumn}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Color, TargetNullValue=—}" Width="110">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource ColorColumn}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16" IsEnabled="{Binding CanEdit}">
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Label Content="{DynamicResource NameLabel}" Target="{Binding ElementName=NameInput}" Padding="0,0,0,5" />
                    <TextBox x:Name="NameInput" Text="{Binding NameInput, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="34" Padding="8,4" VerticalContentAlignment="Center" />
                    <Label Content="{DynamicResource TagColorLabel}" Target="{Binding ElementName=ColorInput}" Padding="0,0,0,5" Margin="0,12,0,0" />
                    <TextBox x:Name="ColorInput" Text="{Binding ColorInput, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="34" Padding="8,4" VerticalContentAlignment="Center" />
                    <TextBlock Text="{Binding ColorHint}" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
                    <DockPanel Margin="0,14,0,0">
                        <Button Content="{DynamicResource DeleteButton}" IsEnabled="{Binding CanDelete}" Click="DeleteTag_Click"
                                DockPanel.Dock="Right" Style="{StaticResource DangerButtonStyle}" MinHeight="34" Padding="12,4" />
                        <Button Content="{DynamicResource SaveButton}" Command="{Binding SaveCommand}" IsDefault="True"
                                HorizontalAlignment="Left" Style="{StaticResource ActionButtonStyle}" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,4"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />
                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <Button Grid.Column="1" Content="{DynamicResource CloseButton}" IsCancel="True" IsEnabled="{Binding CanClose}"
                    Style="{StaticResource DialogButton}" />
        </Grid>
    </Grid>
</Window>
