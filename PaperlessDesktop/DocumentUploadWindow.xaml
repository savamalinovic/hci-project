<Window x:Class="PaperlessDesktop.DocumentUploadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource UploadHeading}" Width="600" Height="590" MinWidth="460" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="14" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,0,0,5" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource StandardTextBoxStyle}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource StandardButtonStyle}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource UploadHeading}" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,14" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid IsEnabled="{Binding CanEdit}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.ColumnSpan="2" Padding="12" Background="{DynamicResource SurfaceBrush}" Margin="0,0,0,15"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" x:Name="PickFileButton" Content="{DynamicResource PickFileButton}"
                                Click="PickFile_Click" Margin="10,0,0,0" />
                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding FileName}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <StackPanel Grid.Row="1" Margin="0,0,10,13">
                    <Label Content="{DynamicResource NameLabel}" Target="{Binding ElementName=TitleTextBox}" />
                    <TextBox x:Name="TitleTextBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,13">
                    <Label Content="{DynamicResource UploadDateLabel}" Target="{Binding ElementName=CreatedTextBox}" />
                    <TextBox x:Name="CreatedTextBox" Text="{Binding CreatedText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,10,13">
                    <Label Content="{DynamicResource UploadCorrespondentLabel}" Target="{Binding ElementName=UploadCorrespondent}" />
                    <ComboBox x:Name="UploadCorrespondent" ItemsSource="{Binding Correspondents}"
                              SelectedItem="{Binding SelectedCorrespondent, Mode=TwoWay}"
                              DisplayMemberPath="Name" MinHeight="34" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,13">
                    <Label Content="{DynamicResource UploadTypeLabel}" Target="{Binding ElementName=UploadDocumentType}" />
                    <ComboBox x:Name="UploadDocumentType" ItemsSource="{Binding DocumentTypes}"
                              SelectedItem="{Binding SelectedDocumentType, Mode=TwoWay}"
                              DisplayMemberPath="Name" MinHeight="34" />
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
                    <TextBlock Text="{DynamicResource TagsColumn}" Margin="0,0,0,5" />
                    <ScrollViewer MaxHeight="122" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Margin="0,0,14,5" Padding="2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,15,0,0">
            <ProgressBar Height="3" Margin="0,0,0,5" IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}"
                         AutomationProperties.Name="{DynamicResource UploadBusyName}" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="{DynamicResource CheckStatusButton}" Command="{Binding CheckStatusCommand}" Margin="0,0,8,0"
                        Visibility="{Binding CanCheckStatus, Converter={StaticResource BooleanToVisibility}}" />
                <Button Content="{DynamicResource SubmitUploadButton}" Command="{Binding SubmitCommand}" Margin="0,0,8,0" Style="{StaticResource ActionButtonStyle}"
                        Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibility}}" />
                <Button Content="{DynamicResource CloseButton}" Click="Close_Click" IsEnabled="{Binding CanClose}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
